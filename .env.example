# =============================================================================
# Research Copilot Agent — Environment Variables
# =============================================================================
# Optional shell environment template (the app does NOT auto-load .env).
# Copy to .env, edit it, then run: set -a; source .env; set +a
# Alternatively use config.local.yaml (see docs/configuration.md).
#
# The only required variable is OPENAI_API_KEY (or your provider's API key).
# All other variables have sensible defaults.
# =============================================================================

# ---- Required ----
OPENAI_API_KEY=sk-your-api-key-here

# ---- Default model (used when routing is disabled) ----
# MODEL_NAME=deepseek-chat

# ---- Simple route (cheap/fast model) ----
# SIMPLE_MODEL_NAME=deepseek-chat
# SIMPLE_MODEL_API_KEY=
# SIMPLE_MODEL_BASE_URL=

# ---- Complex route (powerful reasoning model) ----
# COMPLEX_MODEL_NAME=deepseek-reasoner
# COMPLEX_MODEL_API_KEY=
# COMPLEX_MODEL_BASE_URL=

# ---- Embedding (optional, for vector/hybrid retrieval modes) ----
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
